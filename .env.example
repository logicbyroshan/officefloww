# OfficeFloww Environment Configuration

# Application
APP_ENV=development
APP_NAME=OfficeFloww
APP_DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=super-secret-officefloww-change-in-production-random-token-key-32b
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL for Docker/Production, SQLite fallback in local test)
DATABASE_URL=postgresql+asyncpg://officefloww:officefloww_secure_pass@localhost:5432/officefloww
DATABASE_ECHO=false

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# S3 / MinIO Object Storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=officefloww-files
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_USE_SSL=false

# CORS & Frontend Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","electron://officefloww"]

# Logging
LOG_LEVEL=INFO
