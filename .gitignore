# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Local MinIO / Docker Volumes
docker/minio_data/
docker/postgres_data/
docker/redis_data/
data/

# Temporary / Agent Scratch
.system_generated/
scratch/
