{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@officefloww/api-client": ["../../packages/api-client/dist/index"],
      "@officefloww/api-types": ["../../packages/api-types/dist/index"]
    }
  },
  "include": ["src/**/*"]
}
